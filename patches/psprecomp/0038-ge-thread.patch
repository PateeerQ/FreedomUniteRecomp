+/* Inline, lists are complete by the time they are enqueued, so every sync
+ * succeeds immediately. With the GE thread, mode 0 waits and mode 1 peeks
+ * (0 completed, 1 queued, 2 drawing, 3 stalled; DrawSync: 0 or 2). */
+static void hle_ListSync(void) {
+    if (g_async > 0) {
+        const uint32_t id = psp_arg(0), mode = psp_arg(1);
+        uint32_t r = 0;
+        host_mutex_lock(&g_qlock);
+        ge_queue *q = NULL;
+        for (int i = 0; i < MAX_QUEUES; i++)
+            if (g_queue[i].queued && g_queue[i].id == id) q = &g_queue[i];
+        if (q) {
+            if (mode == 0) wait_locked(until_list, q);
+            else if (g_fifo[0] != q) r = 1;
+            else r = g_qbusy ? 2 : head_runnable() ? 1 : 3;
+        }
+        host_mutex_unlock(&g_qlock);
+        psp_ge_deliver_pending();
+        psp_ret(r);
+        return;
+    }
+    psp_ge_deliver_pending();
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
+static void hle_DrawSync(void) {
+    if (g_async > 0) {
+        uint32_t r = 0;
+        host_mutex_lock(&g_qlock);
+        if (psp_arg(0) == 0) wait_locked(until_idle, NULL);
+        else if (!idle_locked()) r = 2;
+        host_mutex_unlock(&g_qlock);
+        psp_ge_deliver_pending();
+        psp_ret(r);
+        return;
+    }
+    psp_ge_deliver_pending();
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
 
