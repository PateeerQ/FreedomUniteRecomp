+    host_mutex_lock(&g_qlock);
+    for (;;) {
+        while (!head_runnable()) host_cond_wait(&g_qwake, &g_qlock);
+        ge_queue *q = g_fifo[0];
+        if (q->base_pending) { q->base = g_base; q->base_pending = 0; }   /* BASE as the list before left it */
+        g_qbusy = 1;
