+void psp_ge_between_flip(void);
+void psp_ge_between_stats(uint64_t *matched, uint64_t *total);   /* vertices since the last call */
+extern const psp_vertex *psp_render_between_v;
+extern int psp_render_between_n, psp_render_between_prim;
