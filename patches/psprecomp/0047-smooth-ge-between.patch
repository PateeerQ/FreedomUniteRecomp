+/* ---- in-between frames, the GE side (psp_ge_set_between) -------------------
+ *
+ * Each 3D draw is known again in the next frame by what it draws from: the
+ * vertex and index addresses, the format, the count and the primitive, plus
+ * how many times this frame has drawn that already (a model drawn twice). Its
+ * matrices are kept per frame; the next frame transforms the same vertices
+ * with both frames' matrices and takes the point halfway, in clip space, and
+ * only then clips. Matching the backend's vertices afterwards failed: near-
+ * plane clipping changes how many there are from frame to frame (the road
+ * before the camera cracked while running). The vertices' own data is this
+ * frame's: what the CPU moves itself (particles) is not smoothed. */
+const psp_vertex *psp_render_between_v;
+int psp_render_between_n, psp_render_between_prim;
+
+typedef struct { float world[12], view[12], proj[16], bone[8 * 12], morph[8]; } xsnap;
+typedef struct { uint64_t key; uint32_t snap; } bkey;
+#define BTAB 16384                             /* draws a frame can be known by (a power of two) */
+static int      g_bon;
+static bkey    *g_btab[2];
+static xsnap   *g_bsnap[2];
+static uint32_t g_bnsnap[2];
+static int      g_bcur;                        /* this frame's table; the other is the last frame's */
+static uint64_t g_bmatched, g_btotal;
+
+void psp_ge_set_between(int on) { g_bon = on ? 1 : 0; }
+
+void psp_ge_between_flip(void) {
+    if (!g_btab[0]) return;
+    g_bcur ^= 1;
+    memset(g_btab[g_bcur], 0, sizeof(bkey) * BTAB);
+    g_bnsnap[g_bcur] = 0;
+}
+
+void psp_ge_between_stats(uint64_t *matched, uint64_t *total) {
+    *matched = g_bmatched; *total = g_btotal;
+    g_bmatched = g_btotal = 0;
+}
+
+static uint64_t mix64(uint64_t x) {
+    x ^= x >> 33; x *= 0xFF51AFD7ED558CCDull; x ^= x >> 33; x *= 0xC4CEB9FE1A85EC53ull; x ^= x >> 33;
+    return x ? x : 1;
+}
+
+static bkey *bfind(bkey *t, uint64_t key) {
+    for (uint32_t i = (uint32_t)key & (BTAB - 1), n = 0; n < BTAB; i = (i + 1) & (BTAB - 1), n++)
+        if (t[i].key == key || !t[i].key) return &t[i];
+    return NULL;
+}
+
+/* This draw's key in this frame, and its record there (made now, with the
+ * matrices it is drawn with); the last frame's matrices for it, or NULL. */
+static const xsnap *between_key(uint32_t type, uint32_t count) {
+    if (!g_btab[0]) {
+        for (int i = 0; i < 2; i++) {
+            g_btab[i] = (bkey *)calloc(BTAB, sizeof(bkey));
+            g_bsnap[i] = (xsnap *)malloc(sizeof(xsnap) * BTAB);
+            if (!g_btab[i] || !g_bsnap[i]) { g_bon = 0; return NULL; }
+        }
+    }
+    const uint64_t base = mix64(((uint64_t)g_ge.vaddr << 32 | g_ge.iaddr) ^ mix64((uint64_t)g_ge.vtype << 40 ^ (uint64_t)count << 4 ^ type));
+    bkey *cur = g_btab[g_bcur];
+    uint64_t key = base;
+    bkey *e = NULL;
+    for (uint32_t occ = 0; occ < 256; occ++) {   /* the same vertices drawn again: the next occurrence */
+        key = mix64(base + occ * 0x9E3779B97F4A7C15ull);
+        e = bfind(cur, key);
+        if (!e || !e->key) break;
+    }
+    if (!e || e->key || g_bnsnap[g_bcur] >= BTAB) return NULL;
+    e->key = key;
+    e->snap = g_bnsnap[g_bcur]++;
+    xsnap *x = &g_bsnap[g_bcur][e->snap];
+    memcpy(x->world, g_xf.world, sizeof x->world);
+    memcpy(x->view, g_xf.view, sizeof x->view);
+    memcpy(x->proj, g_xf.proj, sizeof x->proj);
+    memcpy(x->bone, g_xf.bone, sizeof x->bone);
+    memcpy(x->morph, g_xf.morph, sizeof x->morph);
+    const bkey *o = bfind(g_btab[g_bcur ^ 1], key);
+    return o && o->key ? &g_bsnap[g_bcur ^ 1][o->snap] : NULL;
+}
+
+/* Vertex `addr`'s clip-space position under the matrices in g_xf. */
+static void vertex_clip(uint32_t addr, uint32_t vtype, const vlayout *L, float c[4]) {
+    const uint8_t *hp = vptr(addr, (uint32_t)L->stride);
+    float pos[3], nrm[3], uv[2], wpos[3], vpos[3];
+    local_vertex(hp, addr, vtype, L, 0, pos, nrm, uv);
+    if (L->w_n) skin(hp, addr, vtype, L, pos, nrm);
+    mul43(g_xf.world, pos, 1.0f, wpos);
+    world_to_clip(wpos, vpos, c);
+}
+
+/* The draw halfway to the last frame's, into psp_render_between_v/n/prim
+ * (left NULL when the last frame did not draw it). Called with the vertices
+ * and indices still mapped (g_vhost, g_ihost). */
+static cvertex    g_bv[65536];
+static psp_vertex g_bflat[65536], *g_btri;
+static void make_between(uint32_t type, uint32_t count, uint32_t vtype, const vlayout *L, int stride, const cvertex *v) {
+    g_btotal += count;
+    const xsnap *o = between_key(type, count);
+    if (!o) return;
+    if (!g_btri && !(g_btri = (psp_vertex *)malloc(sizeof *g_btri * 65536 * 6))) return;
+
+    /* The last frame's positions: its matrices for a moment. */
+    xsnap keep;
+    memcpy(keep.world, g_xf.world, sizeof keep.world); memcpy(g_xf.world, o->world, sizeof keep.world);
+    memcpy(keep.view, g_xf.view, sizeof keep.view);    memcpy(g_xf.view, o->view, sizeof keep.view);
+    memcpy(keep.proj, g_xf.proj, sizeof keep.proj);    memcpy(g_xf.proj, o->proj, sizeof keep.proj);
+    memcpy(keep.bone, g_xf.bone, sizeof keep.bone);    memcpy(g_xf.bone, o->bone, sizeof keep.bone);
+    memcpy(keep.morph, g_xf.morph, sizeof keep.morph); memcpy(g_xf.morph, o->morph, sizeof keep.morph);
+    static float    pc[65536][4];
+    static uint32_t pk[65536], pstamp[65536], pgen;   /* indexed draws repeat vertices: each once */
+    if (++pgen == 0) { memset(pstamp, 0, sizeof pstamp); pgen = 1; }
+    int behind = 0;
+    for (uint32_t n = 0; n < count; n++) {
+        const uint32_t k = vertex_index(vtype, n), slot = k & 0xFFFF;
+        if (pstamp[slot] != pgen || pk[slot] != k) {
+            vertex_clip(g_ge.vaddr + k * (uint32_t)stride, vtype, L, pc[slot]);
+            pstamp[slot] = pgen; pk[slot] = k;
+        }
+        g_bv[n] = v[n];
+        for (int i = 0; i < 4; i++) g_bv[n].c[i] = 0.5f * (pc[slot][i] + v[n].c[i]);
+    }
+    memcpy(g_xf.world, keep.world, sizeof keep.world);
+    memcpy(g_xf.view, keep.view, sizeof keep.view);
+    memcpy(g_xf.proj, keep.proj, sizeof keep.proj);
+    memcpy(g_xf.bone, keep.bone, sizeof keep.bone);
+    memcpy(g_xf.morph, keep.morph, sizeof keep.morph);
+
+    for (uint32_t n = 0; n < count; n++) {
+        if (in_front(&g_bv[n])) clip_to_screen(g_bv[n].c, &g_bv[n].v);
+        else behind = 1;
+    }
+    psp_render_between_prim = (int)type;
+    psp_render_between_v = g_bflat;
+    psp_render_between_n = 0;
+    if (!behind) {
+        for (uint32_t n = 0; n < count; n++) g_bflat[n] = g_bv[n].v;
+        psp_render_between_n = (int)count;
+    } else if (type >= 3 && type <= 5) {
+        const uint64_t clipped = g_xf.clipped, wholly = g_xf.behind;   /* the report counts the frame's own */
+        uint32_t m = 0;
+        for (uint32_t i = 0; i + 2 < count; i += (type == 3 ? 3 : 1))
+            m += clip_triangle(type == 5 ? &g_bv[0] : &g_bv[i], &g_bv[i + 1], &g_bv[i + 2], g_btri + m);
+        g_xf.clipped = clipped; g_xf.behind = wholly;
+        psp_render_between_prim = PSP_PRIM_TRIANGLES;
+        psp_render_between_v = g_btri;
+        psp_render_between_n = (int)m;
+    }
+    g_bmatched += count;
+}
